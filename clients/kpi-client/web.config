<?xml version="1.0" encoding="UTF-8"?>
<!--
  web.config cho site IIS "online.gov.vn" (Frontend Next.js).

  MỤC ĐÍCH: chuyển TẤT CẢ request (kể cả deep-link /auth/sso-callback) cho
  tiến trình Next.js đang chạy `next start -p 8871`, thay vì để IIS tìm file tĩnh
  (đang gây lỗi 404 "File or directory not found").

  YÊU CẦU CÀI TRÊN SERVER (1 lần):
    1. IIS module "URL Rewrite"  (https://www.iis.net/downloads/microsoft/url-rewrite)
    2. IIS module "Application Request Routing (ARR)"
       (https://www.iis.net/downloads/microsoft/application-request-routing)
    3. Bật proxy: IIS Manager -> (chọn server node) -> Application Request Routing Cache
       -> Server Proxy Settings -> tích "Enable proxy" -> Apply.

  CHẠY TIẾN TRÌNH NEXT.JS (nền, dạng service - dùng PM2 hoặc NSSM):
    cd <thư mục FE đã build>
    npm run build        (chỉ khi chưa build)
    npm run start        ( = next start -p 8871 )

  KIỂM TRA NHANH TRÊN SERVER (phải trả về HTML app, không phải 404):
    curl http://localhost:8871/auth/sso-callback
-->
<configuration>
  <!-- Giới hạn tầng ASP.NET (.NET Framework managed pipeline) - TÁCH BIỆT với IIS requestFiltering.
       Mặc định maxUrlLength=260, maxQueryStringLength=2048 -> query JWT dài bị chặn -> "Runtime Error".
       Nâng cho khớp với requestLimits của IIS bên dưới. -->
  <system.web>
    <httpRuntime maxUrlLength="20480" maxQueryStringLength="16384" />
  </system.web>

  <system.webServer>
    <!-- Nâng giới hạn độ dài URL/query string của IIS.
         SSO trả JWT (token + id_token) qua query string dài ~4500+ ký tự,
         vượt mặc định maxQueryString=2048 -> IIS trả 404.15 (Query String too long).
         Nâng lên đủ lớn để không bị chặn. -->
    <security>
      <requestFiltering>
        <requestLimits maxUrl="20480" maxQueryString="16384" />
      </requestFiltering>
    </security>

    <rewrite>
      <rules>
        <!-- Mọi path -> Next.js Node server (cổng 8871). API là subdomain riêng
             (api.online.gov.vn) nên KHÔNG proxy /api ở đây. -->
        <rule name="NextJsReverseProxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:8871/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
